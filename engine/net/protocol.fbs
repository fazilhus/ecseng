namespace fb;

struct Vec3 {
    x: float;
    y: float;
    z: float;
}

struct Quat {
    x: float;
    y: float;
    z: float;
    w: float;
}

table PlayerJoin {
    player_id: uint;
    name: string;
}

table PlayerLeft {
    player_id: uint;
}

table PlayerDeath {
    player_id: uint;
}

table PlayerRespawn {
    player_id: uint;
    pos: Vec3;
}

table EntityState {
    entity_id: uint;
    pos: Vec3;
    rot: Quat;
    vel: Vec3;
    dir: Vec3;
    timestamp: uint;
}

table BatchState {
    entity_states: [EntityState];
}

// Routing / coordination messages
struct PeerAddress {
    host: uint32;
    port: uint16;
}

table PeerList {
    peers: [PeerAddress];
}

table NewPeer {
    address: PeerAddress;
}

table Ping {}
table Pong {}

union Message {
    PlayerJoin,
    PlayerLeft,
    PlayerDeath,
    PlayerRespawn,
    EntityState,
    BatchState,
    PeerList,
    NewPeer,
    Ping,
    Pong,
}

table Envelope {
    message: Message;
}

root_type Envelope;